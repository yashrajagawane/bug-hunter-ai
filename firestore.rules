rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'email', 'xp', 'level', 'coins', 'streak', 'casesSolved', 'createdAt'])
        && data.uid is string && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.username is string && data.username.size() <= 50
        && data.email is string && data.email.size() <= 100
        && data.xp is number
        && data.level is number
        && data.coins is number
        && data.streak is number
        && data.casesSolved is number
        && data.createdAt is timestamp;
    }

    // Case Validation
    function isValidCase(data) {
      return data.keys().hasAll(['title', 'story', 'difficulty', 'language', 'brokenCode', 'expectedBehavior', 'actualBehavior', 'xpReward', 'coinReward'])
        && data.title is string && data.title.size() <= 100
        && data.story is string && data.story.size() <= 5000
        && data.difficulty is string && data.difficulty in ['Beginner', 'Intermediate', 'Advanced', 'Expert']
        && data.language is string && data.language in ['Java', 'Python', 'C++', 'JavaScript']
        && data.brokenCode is string && data.brokenCode.size() <= 10000
        && data.expectedBehavior is string && data.expectedBehavior.size() <= 5000
        && data.actualBehavior is string && data.actualBehavior.size() <= 5000
        && data.xpReward is number
        && data.coinReward is number;
    }

    // Attempt Validation
    function isValidAttempt(data) {
      return data.keys().hasAll(['userId', 'caseId', 'submittedCode', 'score', 'hintsUsed', 'completed', 'createdAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.caseId is string
        && data.submittedCode is string && data.submittedCode.size() <= 10000
        && data.score is number
        && data.hintsUsed is number
        && data.completed is bool
        && data.createdAt is timestamp;
    }

    // Users Collection
    match /users/{userId} {
      // allow list: if isAdmin(); // only admins can list users
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming()) && incoming().createdAt == request.time && incoming().isAdmin == false;
      allow update: if isSignedIn() && userId == request.auth.uid && isValidUser(incoming()) && incoming().createdAt == existing().createdAt && incoming().uid == existing().uid && (incoming().isAdmin == existing().isAdmin || isAdmin());
    }

    // Cases Collection
    match /cases/{caseId} {
      allow read: if isSignedIn(); // Any signed-in user can read cases
      allow create: if isSignedIn();
      allow update: if isAdmin() && isValidCase(incoming());
      allow delete: if isAdmin();
    }

    // Attempts Collection
    match /attempts/{attemptId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(attemptId) && isValidAttempt(incoming()) && incoming().createdAt == request.time && exists(/databases/$(database)/documents/cases/$(incoming().caseId));
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidAttempt(incoming()) && incoming().createdAt == existing().createdAt && incoming().userId == existing().userId && incoming().caseId == existing().caseId;
    }
  }
}
