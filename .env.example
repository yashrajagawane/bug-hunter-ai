# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# FIREBASE_PROJECT_ID: Required by the Firebase Admin SDK on the server to verify user tokens.
# Should match your Firebase project ID below.
FIREBASE_PROJECT_ID="your-project-id"

# Firebase Configuration (Client-side, prefix with VITE_ for Vite)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_FIRESTORE_DB_ID="(default)"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
